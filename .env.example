# ==========================================
# E-Learning 系統環境配置範本 (.env.example)
# ==========================================

# 環境類型: development (測試/開發) 或 production (正式營運)
APP_ENV=development

# 服務埠號
PORT=8000

# 測試環境資料庫 (Development Database)
# DEV_DB_URL=mssql+pymssql://lrnuser:userlrn@dev.db.sysco/eLearn

# 正式環境資料庫 (Production Database)
# 正式帳號密碼為 Terry 處長提供: lrnuser / User39Lrn
# 請替換 <PROD_DB_HOST> 為資訊部提供之正式資料庫伺服器主機名稱或 IP
# PROD_DB_HOST=10.1.100.xxx
# PROD_DB_NAME=eLearn
# DATABASE_URL=mssql+pymssql://lrnuser:User39Lrn@<PROD_DB_HOST>/eLearn
